# Battuta — Environment Configuration
# Copy this file to `.env` and fill in your actual credentials.
#
# DO NOT commit `.env` to source control.

# Google Gemini API Key (used for Optical Music Recognition / OMR in ticket #86e3yy41t)
# Generate your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase Cloud Synchronization & Sharing (Optional)
# Enter your project endpoint and public anon key from Supabase Dashboard > Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: local Supabase stack for development (`supabase start`), offered as
# "Local" in Settings > Supabase Connection. Use the computer's LAN IP for a phone.
SUPABASE_LOCAL_URL=
SUPABASE_LOCAL_PUBLISHABLE_KEY=
